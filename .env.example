# Native development defaults. Docker sets /data and binds inside the container itself.
PIXEL_DATA_DIR=data
PIXEL_LISTEN_HOST=127.0.0.1
PIXEL_BASE_URL=http://localhost:8000
PIXEL_SCRIPT_TIMEOUT=120
PIXEL_RENDER_TIMEOUT=600
PIXEL_BLENDER_THREADS=2
PIXEL_MAX_UPLOAD_BYTES=20971520
PIXEL_MAX_IMAGE_PIXELS=40000000
PIXEL_MAX_RENDER_FRAMES=256
PIXEL_MAX_SHEET_PIXELS=16777216
# JSON arrays. Keep these local unless you deliberately change the deployment boundary.
PIXEL_ALLOWED_HOSTS=["localhost","127.0.0.1","[::1]"]
PIXEL_ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
