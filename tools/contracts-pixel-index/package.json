{
  "name": "@pixel-art-mcp/contracts-pixel-index",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Standalone live pixel-index schema-compatibility checker. Not part of the main app's dependency graph.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "verify": "node dist/verify.js",
    "generate-status-site": "node dist/generate-status-site.js"
  },
  "dependencies": {
    "@pixel-art-mcp/imaging": "workspace:*",
    "@pixel-art-mcp/schema": "workspace:*",
    "ajv": "^8.17.1"
  }
}
